{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "src",
    "strict": true,
    "noEmitOnError": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
