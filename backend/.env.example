# Copie ce fichier en .env (ou exporte ces variables dans ton terminal)
# Clé optionnelle : si elle est définie, l'API exige l'en-tête X-API-Key (utile pour l'app Android)
API_KEY=
# 0.0.0.0 pour tester depuis ton téléphone sur le même Wi-Fi, 127.0.0.1 sinon
HOST=127.0.0.1
PORT=5000

# Clé Google Safe Browsing (optionnelle) : vérifie les liens contre la liste de sites dangereux de Google.
# Gratuit pour un usage non commercial. Créer la clé : https://console.cloud.google.com/apis/credentials
# après avoir activé « Safe Browsing API » dans le projet Google Cloud.
GOOGLE_SAFE_BROWSING_KEY=
